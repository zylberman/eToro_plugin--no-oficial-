{
  "manifest_version": 3,
  "name": "eToro ATR Assistant",
  "version": "2.37",
  "description": "Calculates ATR, break-even TP and exploratory Fourier/Haar signals.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "eToro ATR Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://*.etoro.com/*",
    "https://api.allorigins.win/*",
    "https://cors-anywhere.com/*",
    "https://query1.finance.yahoo.com/*",
    "https://query2.finance.yahoo.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "web_accessible_resources": [
    {
      "resources": ["icons/*.png"],
      "matches": ["https://www.etoro.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://www.etoro.com/*"],
      "js": ["analytics.js", "content.js"],
      "css": ["style.css"],
      "run_at": "document_idle"
    }
  ]
}
